# ---------------------------------------------------------------------------
# Apenas NOMES de variáveis e valores ilustrativos. Os valores reais ficam SOMENTE
# em Netlify > Site configuration > Environment variables (nunca no repositório).
# ---------------------------------------------------------------------------

# Banco (Supabase Postgres) — já existente no projeto
SUPABASE_DB_POOLER_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres

# PromissePay (PIX) — https://promisse.com.br/docs
# Chave de API (formato sk_live_...). Aparece UMA vez no painel; vai crua no header Authorization.
PROMISSEPAY_API_KEY=sk_live_exemplo_nao_e_um_segredo_real
# Secret do webhook, exibida ao cadastrar o webhook no painel. Valida a assinatura HMAC.
PROMISSEPAY_WEBHOOK_SECRET=exemplo_nao_e_um_segredo_real
# Opcional (padrão: https://api.promisse.com.br). Precisa ser HTTPS.
PROMISSEPAY_BASE_URL=https://api.promisse.com.br
# Opcional: timeout das chamadas à API em ms (padrão 8000).
PROMISSEPAY_TIMEOUT_MS=8000

# Pontuação
POINTS_PER_REAL=1

# WhatsApp API / Meta Cloud API-compatible endpoint
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_OWNER_PHONE=

# Optional timezone used in WhatsApp notification
TZ=America/Fortaleza
