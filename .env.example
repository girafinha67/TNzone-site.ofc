# ---------------------------------------------------------------------------
# Variáveis de ambiente — configure estas mesmas chaves em
# Netlify → Site configuration → Environment variables.
# Não coloque valores reais ou senhas neste arquivo.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Supabase — banco de dados (use a URI do Session Pooler)
SUPABASE_DB_POOLER_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Supabase — projeto e Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro administrador.
# O bucket público "tnzone-images" deve existir no Supabase Storage.
# A senha deve ser cadastrada como ADMIN_PASSWORD diretamente no Netlify,
# nunca commitada no repositório.
ADMIN_EMAIL=admin@TNzone.com
ADMIN_PASSWORD=